generator client {
  provider = "prisma-client-js"
}

// Using SQLite for lightning-fast local MVP development
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String
  role          String   // "Admin" or "Staff"
}

model Staff {
  id            String       @id @default(uuid())
  staff_id      String       @unique
  name          String
  email         String       @unique
  phone         String?
  department_id String
  position      String
  
  department    Department   @relation(fields: [department_id], references: [id])
  assignments   Assignment[]
}

model Department {
  id          String       @id @default(uuid())
  name        String
  faculty     String
  
  staff       Staff[]
  assets      Asset[]
}

model Category {
  id     String  @id @default(uuid())
  name   String  @unique
  assets Asset[]
}

model Asset {
  id             String        @id @default(uuid())
  asset_id       String        @unique // e.g., UIB-ICT-0001
  name           String
  category_id    String
  serial_number  String?       @unique
  department_id  String
  assigned_to    String?       // Maps to Staff ID
  location       String
  purchase_date  DateTime?
  purchase_price Float?
  condition      String        // "New", "Good", "Fair", "Damaged", "Critical"
  status         String        // "Available", "In Use", "Maintenance", "Damaged", "Retired"
  
  category       Category      @relation(fields: [category_id], references: [id])
  department     Department    @relation(fields: [department_id], references: [id])
  assignments    Assignment[]
  maintenance    Maintenance[]
}

model Assignment {
  id            String    @id @default(uuid())
  asset_id      String
  staff_id      String?
  department_id String
  location      String
  assigned_at   DateTime  @default(now())
  ended_at      DateTime?

  asset         Asset     @relation(fields: [asset_id], references: [id])
  staff         Staff?    @relation(fields: [staff_id], references: [id])
}

model Maintenance {
  id           String    @id @default(uuid())
  asset_id     String
  problem      String
  reported_at  DateTime  @default(now())
  technician   String?
  cost         Float?
  status       String    // "Pending", "In Progress", "Completed"
  remarks      String?
  completed_at DateTime?

  asset        Asset     @relation(fields: [asset_id], references: [id])
}

model AssetHistory {
  id         String   @id @default(uuid())
  asset_id   String
  action     String   // e.g., "Created", "Updated", "Assigned"
  details    String   // e.g., "Status changed from Available to In Use"
  changed_by String   @default("System Admin") // Real-world: Use JWT User ID
  created_at DateTime @default(now())
}